{
  "name": "jules-clone-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready full-stack Jules clone monorepo for autonomous coding agents deployed on Vercel",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "uvicorn apps.api.main:app --reload --reload-dir apps/api --port 8000",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test:api": "pytest apps/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
