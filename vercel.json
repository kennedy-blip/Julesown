{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "apps/api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/main.py"
    },
    {
      "src": "/_next/static/immutable/(.*)",
      "dest": "/_next/static/$1"
    },
    {
      "src": "/_next/static/(.*)",
      "dest": "apps/web/.next/static/$1"
    }
  ]
}
