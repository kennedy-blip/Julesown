{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "apps/api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    },
    {
      "handle": "error"
    },
    {
      "src": "/(?!api/).*",
      "status": 404,
      "dest": "/apps/web/404"
    }
  ]
}
