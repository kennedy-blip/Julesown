# ==============================================================================
# Project Jules Clone - Environment Variables Template
# ==============================================================================

# LLM Providers (At least one is required for agent reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# E2B Sandbox (Required for isolated Linux microVM code execution)
# Get your key at https://e2b.dev
E2B_API_KEY=your_e2b_api_key_here

# GitHub Integration & Webhooks
# Secret key configured in your GitHub App or Webhook settings
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Optional GitHub Personal Access Token or GitHub App Private Key for PR creation
GITHUB_TOKEN=your_github_personal_access_token_here

# Backend Service Settings
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=info
