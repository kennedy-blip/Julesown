# ==============================================================================
# Jules Clone - environment variables
#
# Local development: copy this file to `.env` and fill it in; the backend loads
# it automatically. On Vercel: add the same variables under
# Project -> Settings -> Environment Variables, then redeploy.
#
# Values left as `your_..._here` (or empty) count as "not set".
# GET /api/v1/health/env reports what is configured and what is still missing.
# ==============================================================================

# ------------------------------------------------------------------------------
# Model providers - at least ONE key is needed, here or in the dashboard
# (Settings -> AI models keeps a key in the browser and sends it with each task).
#
# With several keys a task starts with the first provider in this order and
# carries on with the next one when it reaches its rate limit or fails:
#   Groq, Gemini, OpenRouter, OpenAI, Anthropic
# Tasks started from GitHub (/jules comments, automatic fixes of failed checks)
# can only use the keys set here.
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
# Google AI Studio (https://aistudio.google.com/apikey). GOOGLE_API_KEY works too.
GEMINI_API_KEY=your_gemini_api_key_here
# https://openrouter.ai/keys - one key for many models, including free ones.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: the provider tasks start with (groq | gemini | openrouter | openai |
# anthropic), the order of the rest, and whether to carry on with the next
# provider at all (default true).
# JULES_LLM_PROVIDER=groq
# JULES_LLM_ORDER=groq,gemini,openrouter,openai,anthropic
# JULES_LLM_FALLBACK=true

# Optional: the model per provider (defaults shown). Model catalogues change; if
# a configured model has been retired the backend falls back to an available
# one and notes it in the task log.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-latest
# OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# OPENAI_MODEL=gpt-6-luna
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: sampling temperature for Groq and OpenRouter, 0-2 (default 0.2). A
# low value makes malformed tool calls and made-up content less likely;
# "default" leaves the choice to the provider.
# GROQ_TEMPERATURE=0.2
# OPENROUTER_TEMPERATURE=0.2
# Optional: how much Gemini thinks before answering: minimal | low | medium |
# high | default (default: low).
# GEMINI_THINKING_LEVEL=low

# ------------------------------------------------------------------------------
# E2B sandbox - required. The repository is cloned, edited and tested in it.
# Get a key at https://e2b.dev
# ------------------------------------------------------------------------------
E2B_API_KEY=your_e2b_api_key_here
# Optional: a custom sandbox template with your toolchain preinstalled.
# E2B_TEMPLATE=

# ------------------------------------------------------------------------------
# GitHub - required: EITHER a GitHub App (recommended) OR a token.
# Used to push the task branch and open the pull request.
# ------------------------------------------------------------------------------
# GitHub App: needs repository permissions "Contents: Read and write" and
# "Pull requests: Read and write", and must be installed on the target repos.
# To see and fix failed checks, also "Checks: Read-only" and "Commit statuses:
# Read-only" ("Actions: Read-only" lets the agent read the log of a failed job).
GITHUB_APP_ID=your_github_app_id_here
# The App's private key (.pem). Paste it whole; "\n"-escaped or base64 also work.
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_here

# Alternative: a personal access token with contents + pull request write access.
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: lets GitHub start tasks. "/jules <instructions>" in an issue or a
# comment starts one (on a pull request: more work on that pull request, or
# "/jules fix the checks"), and failed checks of Jules' own pull requests are
# fixed unasked. Must equal the secret configured on the GitHub App /
# repository webhook. Events: Issues, Issue comment, Check suite, Status.
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# Behaviour (optional; defaults shown)
# ------------------------------------------------------------------------------
# Fix failed checks of pull requests Jules opened, without being asked, and how
# many times per pull request at most.
# JULES_CI_AUTOFIX=true
# JULES_CI_AUTOFIX_ATTEMPTS=2
# When a run is cut short (time budget, provider limits), deliver what the
# agent had changed as a pull request marked "[Unfinished]" instead of
# discarding it.
# JULES_KEEP_UNFINISHED_WORK=true
# Who commits are attributed to: bot (the GitHub App, "Verified"), coauthor
# (the App, with a Co-authored-by line naming a person) or user (the person is
# the author; not "Verified"). The dashboard's Settings -> Commits sets this
# per browser. Use the account's noreply address to keep a private one private:
# <id>+<login>@users.noreply.github.com
# JULES_COMMIT_AUTHORSHIP=bot
# JULES_COMMIT_AUTHOR_NAME=
# JULES_COMMIT_AUTHOR_EMAIL=

# ------------------------------------------------------------------------------
# Access control
# Running a task spends your LLM/sandbox quota and uses your GitHub credentials.
# On a public deployment tasks are LOCKED until one of these is set.
# ------------------------------------------------------------------------------
# Recommended: a long random value. The dashboard asks for it; API clients send
# "Authorization: Bearer <key>".
JULES_ACCESS_KEY=your_jules_access_key_here
# Or allow anyone who has the URL to run tasks (not recommended):
# JULES_ALLOW_PUBLIC_ACCESS=true
# Optional: let other websites call the API from a browser (comma-separated
# origins). The dashboard does not need this.
# JULES_CORS_ORIGINS=https://tools.example.com

# ------------------------------------------------------------------------------
# Limits (optional; defaults shown)
# ------------------------------------------------------------------------------
# JULES_TASK_BUDGET_SECONDS=270
# JULES_MAX_AGENT_TURNS=30
# JULES_COMMAND_TIMEOUT_SECONDS=120
# JULES_MAX_OUTPUT_TOKENS=8192

# ------------------------------------------------------------------------------
# Environment name (development | production). "production" behaves like a
# public deployment: tasks are locked without JULES_ACCESS_KEY.
# ------------------------------------------------------------------------------
ENVIRONMENT=development
