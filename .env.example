# ==============================================================================
# Jules Clone - environment variables
#
# Local development: copy this file to `.env` and fill it in; the backend loads
# it automatically. On Vercel: add the same variables under
# Project -> Settings -> Environment Variables, then redeploy.
#
# Values left as `your_..._here` (or empty) count as "not set".
# GET /api/v1/health/env reports what is configured and what is still missing.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM provider - at least ONE key is required.
# If several are set the order of preference is Groq, OpenAI, Anthropic.
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: force a provider (groq | openai | anthropic) and/or a model.
# Model catalogues change; if a configured model has been retired the backend
# falls back to an available one and notes it in the task log.
# JULES_LLM_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-6-luna
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ------------------------------------------------------------------------------
# E2B sandbox - required. The repository is cloned, edited and tested in it.
# Get a key at https://e2b.dev
# ------------------------------------------------------------------------------
E2B_API_KEY=your_e2b_api_key_here
# Optional: a custom sandbox template with your toolchain preinstalled.
# E2B_TEMPLATE=

# ------------------------------------------------------------------------------
# GitHub - required: EITHER a GitHub App (recommended) OR a token.
# Used to push the task branch and open the pull request.
# ------------------------------------------------------------------------------
# GitHub App: needs repository permissions "Contents: Read and write" and
# "Pull requests: Read and write", and must be installed on the target repos.
GITHUB_APP_ID=your_github_app_id_here
# The App's private key (.pem). Paste it whole; "\n"-escaped or base64 also work.
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_here

# Alternative: a personal access token with contents + pull request write access.
GITHUB_TOKEN=your_github_personal_access_token_here

# Optional: lets "/jules <instructions>" in an issue or issue comment start a
# task. Must equal the secret configured on the GitHub App / repository webhook.
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# Access control
# Running a task spends your LLM/sandbox quota and uses your GitHub credentials.
# On a public deployment tasks are LOCKED until one of these is set.
# ------------------------------------------------------------------------------
# Recommended: a long random value. The dashboard asks for it; API clients send
# "Authorization: Bearer <key>".
JULES_ACCESS_KEY=your_jules_access_key_here
# Or allow anyone who has the URL to run tasks (not recommended):
# JULES_ALLOW_PUBLIC_ACCESS=true
# Optional: let other websites call the API from a browser (comma-separated
# origins). The dashboard does not need this.
# JULES_CORS_ORIGINS=https://tools.example.com

# ------------------------------------------------------------------------------
# Limits (optional; defaults shown)
# ------------------------------------------------------------------------------
# JULES_TASK_BUDGET_SECONDS=270
# JULES_MAX_AGENT_TURNS=30
# JULES_COMMAND_TIMEOUT_SECONDS=120
# JULES_MAX_OUTPUT_TOKENS=8192

# ------------------------------------------------------------------------------
# Environment name (development | production). "production" behaves like a
# public deployment: tasks are locked without JULES_ACCESS_KEY.
# ------------------------------------------------------------------------------
ENVIRONMENT=development
